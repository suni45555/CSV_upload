{
    "_version": "1.12.0",
    "sap.app": {
        "id": "csvupload",
        "type": "application",
        "title": "Material Config Staging",
        "dataSources": {
            "stagingService": {
                "uri": "/odata/v4/staging/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.unified": {},
                "sap.ui.layout": {}
            }
        },
        "models": {
            "": {
                "dataSource": "stagingService",
                "type": "sap.ui.model.odata.v4.ODataModel",
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "groupId": "$auto"
                }
            }
        },
        "rootView": {
            "viewName": "csvupload.view.Main",
            "type": "XML",
            "id": "mainView"
        }
    }
}

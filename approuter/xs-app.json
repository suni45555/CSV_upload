{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/api/readonly(.*)$",
      "target": "/api/readonly$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/app/(.*)$",
      "localDir": "webapp",
      "authenticationType": "none"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    }
  ]
}
